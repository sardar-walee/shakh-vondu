{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User accounts with role-based access for customers, sellers, admins, and delivery drivers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "fullName": { "type": "string", "description": "Full name in Kurdish/English" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "role": { "type": "string", "enum": ["customer", "seller", "admin", "delivery"], "description": "User role" },
        "city": { "type": "string", "description": "City in Kurdistan" },
        "area": { "type": "string", "description": "Neighborhood/Area" },
        "address": { "type": "string", "description": "Street address" },
        "avatarUrl": { "type": "string", "format": "uri", "description": "Profile picture URL" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "role"]
    },
    "Seller": {
      "title": "Seller Store",
      "description": "Store profile for merchants with delivery radius and zone settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeName": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "coverUrl": { "type": "string", "format": "uri" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "commissionRate": { "type": "number" },
        "rating": { "type": "number" },
        "totalReviews": { "type": "number" },
        "totalSales": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "deliveryZone": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "storeName", "category"]
    },
    "Product": {
      "title": "Product",
      "description": "Products offered across food, market, meat, vegetables, clothes, electronics, cars, beauty, dairy, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "gender": { "type": "string" },
        "material": { "type": "string" },
        "warrantyMonths": { "type": "number" },
        "specs": { "type": "object" },
        "year": { "type": "number" },
        "mileageKm": { "type": "number" },
        "fuelType": { "type": "string" },
        "transmission": { "type": "string" },
        "prepTimeMinutes": { "type": "number" },
        "ingredients": { "type": "array", "items": { "type": "string" } },
        "isSpicy": { "type": "boolean" },
        "isVegetarian": { "type": "boolean" },
        "meatType": { "type": "string" },
        "cutType": { "type": "string" },
        "isOrganic": { "type": "boolean" },
        "fatPercentage": { "type": "string" },
        "origin": { "type": "string" },
        "skinType": { "type": "string" },
        "volume": { "type": "string" },
        "weight": { "type": "string" },
        "expiryInfo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "price", "category", "sellerId"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Multi-vendor orders with delivery zone distance calculation and real-time statuses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "deliveryDistanceKm": { "type": "number" },
        "deliveryZoneStatus": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "ready_for_pickup", "picked_up", "out_for_delivery", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "deliveryCity": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "total", "status", "paymentMethod", "deliveryAddress"]
    },
    "Car": {
      "title": "Car Marketplace Listing",
      "description": "Car ads for Kurdish automotive marketplace with required payment receipt verification and pending approval status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "title": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "mileageKm": { "type": "number" },
        "priceIqd": { "type": "number" },
        "priceUsd": { "type": "number" },
        "city": { "type": "string" },
        "transmission": { "type": "string" },
        "fuelType": { "type": "string" },
        "color": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "adStatus": { "type": "string", "enum": ["pending_approval", "pending_payment", "active", "expired", "rejected", "sold", "hidden"] },
        "adminApprovalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminRejectionReason": { "type": "string" },
        "adminApprovedAt": { "type": "string", "format": "date-time" },
        "packageType": { "type": "string", "enum": ["1_week", "15_days", "1_month"] },
        "packagePrice": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "refunded"] },
        "paymentProofUrl": { "type": "string", "description": "Payment receipt image URL or base64 data required for verification before post is made public" },
        "paymentMethodUsed": { "type": "string" },
        "paymentSenderPhone": { "type": "string" },
        "paymentRef": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "startDate": { "type": "string", "format": "date-time" },
        "expirationDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "brand", "model", "year", "priceIqd", "adStatus", "adminApprovalStatus"]
    },
    "Review": {
      "title": "Review & Rating",
      "description": "Customer reviews and star ratings for sellers, delivery captains, and products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "targetType": { "type": "string", "enum": ["seller", "driver", "product"] },
        "targetId": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sellerReply": { "type": "object" },
        "driverReply": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderId", "userId", "targetType", "targetId", "rating", "comment"]
    },
    "PointsSettings": {
      "title": "Points System Settings",
      "description": "Configurable points conversion settings (e.g. 150 points = 1 IQD)",
      "type": "object",
      "properties": {
        "pointsPerIQD": { "type": "number", "description": "Conversion rate: 150 points = 1 IQD" },
        "minRedemptionPoints": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pointsPerIQD"]
    },
    "Favorite": {
      "title": "Favorite Item / Wishlist",
      "description": "Customer wishlist and favorites items for products and sellers stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["product", "seller"] },
        "productId": { "type": "string" },
        "sellerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "targetType"]
    },
    "FcmToken": {
      "title": "FCM Push Token Registration",
      "description": "Firebase Cloud Messaging token registrations for web browser push notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "userRole": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "permissionGranted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "token"]
    },
    "PromotionalOffer": {
      "title": "Promotional Offer Broadcast",
      "description": "Real-time FCM promotional offer push campaigns sent by admins or sellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "discountCode": { "type": "string" },
        "targetUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "audience": { "type": "string", "enum": ["all", "customers", "sellers", "captains"] },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "senderId"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User documents" },
    "/sellers/{sellerId}": { "schema": "Seller", "description": "Seller store documents" },
    "/products/{productId}": { "schema": "Product", "description": "Product catalog" },
    "/orders/{orderId}": { "schema": "Order", "description": "Orders collection" },
    "/cars/{carId}": { "schema": "Car", "description": "Cars marketplace collection" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Customer ratings and reviews" },
    "/favorites/{favoriteId}": { "schema": "Favorite", "description": "Customer wishlist and favorites collection" },
    "/fcmTokens/{tokenId}": { "schema": "FcmToken", "description": "Device FCM push notification tokens" },
    "/promotional_offers/{offerId}": { "schema": "PromotionalOffer", "description": "Promotional offer push notification campaigns" },
    "/system_settings/points_config": { "schema": "PointsSettings", "description": "Global points conversion rate config" }
  }
}
