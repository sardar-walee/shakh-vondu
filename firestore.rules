rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@shakh.com' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.uid == 'admin-super'
      );
    }

    // 1. Products Collection: Publicly readable by all users across all platforms
    match /products/{productId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 2. Cars Collection: Publicly readable for all active ads
    match /cars/{carId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 3. Sellers Collection: Public storefront directory
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Wallets & Agreements
    match /wallets/{walletId} {
      allow read: if true;
      allow write: if true;
    }

    match /agreements/{agreementId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. Favorites & Tokens
    match /favorites/{favoriteId} {
      allow read: if true;
      allow write: if true;
    }

    match /fcmTokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }

    // 11. Promotional Offers & System Settings
    match /promotional_offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Catch-All
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
