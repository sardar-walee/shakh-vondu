rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Sellers Collection (Public storefronts for all buyers)
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Products Collection (Publicly visible to all customers across marketplace)
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Cars Collection (Publicly visible to all customers in Shakh Auto)
    match /cars/{carId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Reviews & Ratings (Publicly visible to all customers)
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Seller Wallets & Financial Ledger
    match /wallets/{walletId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Seller Agreements
    match /agreements/{agreementId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. User Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // 11. Favorites Collection
    match /favorites/{favoriteId} {
      allow read: if true;
      allow write: if true;
    }

    // 12. FCM Device Tokens Collection
    match /fcmTokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }

    // 13. Promotional Offers Collection
    match /promotional_offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    // 14. System Settings & Banners (Publicly readable)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Catch-All
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
